% SampleID: ex2-file1 0
% Theoretical instrumental function
VERZERR=cubix-ads-10mm.geq
% Wavelength
LAMBDA=CU
% Polarization (CuKa with Graphite monochromator)
POL=sqr(cos(26.6*pi/180))
pi=2*acos(0)
% Phases
STRUC[1]=Apatite-OH.str
% Measured data
VAL[1]=ex2-file1.xy
% Minimum Angle (2theta)
% WMIN=10
% Maximum Angle (2theta)
% WMAX=60
% Result list output
LIST=ex2-file1.lst
% Peak list output
OUTPUT=ex2-file1.par
% Diagram output
DIAGRAMM=ex2-file1.dia
% Global parameters for zero point and sample displacement
EPS1=0
PARAM[1]=EPS2=0_-0.01^0.01
alpha3ratio=0.02
betaratio=0
NTHREADS=10
PROTOKOLL=Y

sum=Hydroxyapatite
QHydroxyapatite=Hydroxyapatite/sum

GOAL[1]=QHydroxyapatite